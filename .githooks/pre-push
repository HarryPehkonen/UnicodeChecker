#!/usr/bin/env bash
#
# pre-push: the FULL tier — the gate, on the tree you are about to publish.
#
# from AI-DEV-STARTER (plunk-in kit) — if you edit this file, say why in INCIDENTS.md.
# Install as .githooks/pre-push and arm it once per clone:
#
#     git config core.hooksPath .githooks
#
# For C++ it also requires a clean worktree and proves the COMMITTED tree is complete
# by building and testing a pristine checkout of HEAD. For deno/python the same script
# is already the whole gate and already includes its own clean-checkout story.
#
# Deliberate bypass when you need one:  git push --no-verify
#
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1

if [ -x "$root/tools/ci.sh" ]; then
    # No stage list here: the push runs whatever CI_DEFAULT_STAGES says, so the two cannot
    # drift apart. This repo had an explicit list and it fell behind -- a twelfth stage was
    # added to the gate and to CI_DEFAULT_STAGES, and the push went on running eleven, with
    # nothing anywhere saying so. "One definition, N callers" is the kit's own rule; a second
    # list is a second definition, and the failure it hides is a stage that exists but never
    # runs. kitprobes and release stay in that default set for the reasons they were named
    # there: a probe runs in under a second and needs no kit checkout, and the SECOND build
    # configuration has to actually be built by something.
    exec "$root/tools/ci.sh" --require-clean
fi

if [ -x "$root/scripts/gate.sh" ]; then
    exec "$root/scripts/gate.sh"
fi

printf 'pre-push: no gate found. Expected %s/tools/ci.sh (C++) or %s/scripts/gate.sh (deno/python).\n' \
    "$root" "$root" >&2
exit 1
